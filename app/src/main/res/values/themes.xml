<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Segue o tema do sistema; fundo certo desde o primeiro frame, sem flash. -->
    <style name="Theme.Habito" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/hb_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Tela de abertura com o ícone animado; depois troca para o tema do app. -->
    <style name="Theme.Habito.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hb_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">620</item>
        <item name="postSplashScreenTheme">@style/Theme.Habito</item>
    </style>
</resources>
