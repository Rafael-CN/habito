<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:name=".HabitApp"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Habito">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode"
            android:theme="@style/Theme.Habito.Starting"
            android:windowSoftInputMode="adjustResize">
            <!-- Tocar e segurar o bloco rápido abre o app. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
        <!-- Ícones: um alias por cor; só um fica ligado (IconSwitcher). -->
        <activity-alias
            android:name=".IconOriginal"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
        </activity-alias>
        <activity-alias
            android:name=".IconVerde"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_verde"
            android:roundIcon="@mipmap/ic_launcher_verde"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
        </activity-alias>
        <activity-alias
            android:name=".IconRosa"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rosa"
            android:roundIcon="@mipmap/ic_launcher_rosa"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAzul"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_azul"
            android:roundIcon="@mipmap/ic_launcher_azul"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOceano"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_oceano"
            android:roundIcon="@mipmap/ic_launcher_oceano"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconVioleta"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_violeta"
            android:roundIcon="@mipmap/ic_launcher_violeta"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAmbar"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ambar"
            android:roundIcon="@mipmap/ic_launcher_ambar"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconTerracota"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_terracota"
            android:roundIcon="@mipmap/ic_launcher_terracota"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGrafite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_grafite"
            android:roundIcon="@mipmap/ic_launcher_grafite"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Habito">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".HabitWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_info" />
        </receiver>
        <receiver
            android:name=".MarkDoneReceiver"
            android:exported="false" />
        <receiver
            android:name=".HabitWidgetSmallReceiver"
            android:exported="true"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_small_info" />
        </receiver>
        <service
            android:name=".HabitTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
